local function rawRequest(method, endpoint, bodyStr)
    local url = SUPABASE_URL .. "/rest/v1/" .. endpoint
    local headers = {
        ["apikey"] = SUPABASE_KEY,
        ["Authorization"] = "Bearer " .. SUPABASE_KEY,
        ["Content-Type"] = "application/json",
        ["Prefer"] = "return=representation"
    }
    local success, result = pcall(function()
        return request({ Url = url, Method = method, Headers = headers, Body = bodyStr })
    end)
    if not success then return nil end
    if result.StatusCode ~= 200 and result.StatusCode ~= 201 then return nil end
    if result.Body and result.Body ~= "" then
        local ok, data = pcall(function() return HttpService:JSONDecode(result.Body) end)
        if ok then return data end
    end
    return nil
end

local function escapeStr(s)
    return tostring(s):gsub('\\', '\\\\'):gsub('"', '\\"')
end

local function fetchUser()
    local data = rawRequest("GET", TABLE_NAME .. "?user_id=eq." .. userId .. "&select=*", nil)
    if data and type(data) == "table" and #data > 0 then
        return data[1]
    end
    return nil
end

