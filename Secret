-- === Fonction pour trouver un module dans ReplicatedStorage avec plusieurs chemins ===
local function findModule(parts)
    local current = ReplicatedStorage
    for _, part in ipairs(parts) do
        current = current:FindFirstChild(part)
        if not current then
            return nil
        end
    end
    return current
end

local function safeRequire(paths)
    for _, path in ipairs(paths) do
        local module = findModule(path)
        if module then
            local ok, result = pcall(require, module)
            if ok then
                return result
            end
        end
    end
    return nil
end

-- === Chargement des modules Datas avec fallback ===
local AnimalsData = safeRequire({
    {"Datas", "Animals"},
    {"Shared", "Datas", "Animals"},
    {"Modules", "Datas", "Animals"},
    {"Data", "Animals"} -- alternative
})

local GameData = safeRequire({
    {"Datas", "Game"},
    {"Shared", "Datas", "Game"},
    {"Modules", "Datas", "Game"},
    {"Data", "Game"}
