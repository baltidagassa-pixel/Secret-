local function scanAllBrainrots()
    local brainrotQueue = {}
    local podiums = capturedData["AnimalPodiums"]
    if type(podiums) == "table" then
        for slotKey, animalData in pairs(podiums) do
            if type(animalData) == "table" and animalData.Index then
                local genRaw, genRounded = getRealValue(animalData.Index, animalData.Mutation, animalData.Traits)
                table.insert(brainrotQueue, {
                    slotKey = tonumber(slotKey),
                    index = animalData.Index,
                    mutation = animalData.Mutation or "None",
                    traits = animalData.Traits or {},
                    genValue = genRaw,
                    genValueRounded = genRounded,
                })
            end
        end
    end
    return brainrotQueue
end

local function getInDuelBrainrot()
    local currentDuel = capturedData["CurrentDuel"]
    if not currentDuel then return nil end

    local duelHistory = capturedData["DuelHistory"]
    if not duelHistory then return nil end

    local latest = duelHistory[1]
    if not latest or not latest.Brainrot then return nil end

    local brainrot = latest.Brainrot
    local genRaw, genRounded = getRealValue(brainrot.Index, brainrot.Mutation, brainrot.Traits)
    return {
        index = brainrot.Index,
        mutation = brainrot.Mutation or "None",
        traits = brainrot.Traits or {},
        genValue = genRaw,
        genValueRounded = genRounded
    }
end

local function encodeInDuel(inDuelBrainrot)
    if inDuelBrainrot == nil then return "null" end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(inDuelBrainrot) end)
    return ok and encoded or "null"
end

