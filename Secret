    local function parseGeneration(str)
        if not str then return 0 end
        str = tostring(str):gsub("%s",""):gsub(",",""):gsub("/s","")
        local num, suf = str:match("([%d%.]+)([KkMmBbTt]?)$")
        if not num then return tonumber(str:match("%d+%.?%d*")) or 0 end
        num = tonumber(num)
        suf = (suf or ""):upper()
        if suf == "K" then return num * 1000
        elseif suf == "M" then return num * 1000000
        elseif suf == "B" then return num * 1000000000
        elseif suf == "T" then return num * 1000000000000
        else return num end
    end

    local function formatNumber(n)
        if not n then return "$0/s" end
        local function clean(s) return s:gsub("%.?0+$", "") end
        if n >= 1e12 then return "$" .. clean(string.format("%.2f", n / 1e12)) .. "T/s" end
        if n >= 1e9 then return "$" .. clean(string.format("%.2f", n / 1e9)) .. "B/s" end
        if n >= 1e6 then return "$" .. clean(string.format("%.2f", n / 1e6)) .. "M/s" end
        if n >= 1e3 then return "$" .. clean(string.format("%.2f", n / 1e3)) .. "K/s" end
        return "$" .. tostring(math.floor(n)) .. "/s"
    end

